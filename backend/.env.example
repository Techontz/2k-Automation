APP_NAME="2K Automation"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Public URL of the Next.js dashboard (OAuth callbacks redirect here)
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database -------------------------------------------------------------
# Local quick start uses SQLite. Production: MySQL 8 (see docker-compose.yml).
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=two_k_automation
# DB_USERNAME=twok
# DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# --- Queues & cache ---------------------------------------------------------
# Local: database queue + `php artisan queue:work`. Production: redis.
QUEUE_CONNECTION=database
CACHE_STORE=database
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
QUEUE_WEBHOOKS=webhooks
QUEUE_AUTOMATIONS=automations
QUEUE_EMAIL=email

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Run simulator events inline so results show instantly without a worker.
SIMULATOR_SYNC=true

# --- Default mailer (workspaces can add their own SMTP providers) ----------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Meta (Facebook Messenger, WhatsApp, webhooks) — docs/SETUP_INTEGRATIONS.md
META_GRAPH_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
# Any long random string; paste the same value into the Meta webhook config.
META_WEBHOOK_VERIFY_TOKEN=

# --- Instagram API with Instagram Login ------------------------------------
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- WhatsApp Embedded Signup (optional) ------------------------------------
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=

# --- TikTok API for Business -------------------------------------------------
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_API_BASE=https://business-api.tiktok.com/open_api/v1.3

# --- AI providers (platform defaults; workspaces may bring their own key) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

VITE_APP_NAME="${APP_NAME}"
